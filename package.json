{
  "name": "reiadown-unified",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "nodemon --watch server -e ts --exec ts-node --project tsconfig.server.json server/index.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "vue-tsc --noEmit && vite build",
    "build:backend": "tsc -p tsconfig.server.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist-server/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.500.0",
    "@material/web": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^14.0.0",
    "mysql2": "^3.6.5",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "node-cron": "^3.0.3" ,
    "mobile-drag-drop": "^2.3.0-rc.2",
    "xgplayer": "^3.0.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/markdown-it": "^14.0.1",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.5",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.13"
  }
}